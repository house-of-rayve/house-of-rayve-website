generator client {
  provider = "prisma-client-js"
}

// Supabase Postgres. DATABASE_URL = pooled connection (app), DIRECT_URL = direct connection (schema changes).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String? // null for accounts created with Google sign-in
  googleId     String?   @unique
  avatarUrl    String?
  role         String    @default("CUSTOMER") // CUSTOMER | ADMIN
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  points       PointsEntry[]
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   @default("Home")
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Product {
  id           String      @id @default(cuid())
  name         String
  slug         String      @unique
  tagline      String?
  description  String
  category     String      @default("Sunglasses") // Sunglasses | Optical
  shape        String?
  frameColor   String?
  lensColor    String?
  material     String?
  lensWidth    Int? // mm — for the size guide
  bridgeWidth  Int? // mm
  templeLength Int? // mm
  price        Int
  comparePrice Int?
  stock        Int         @default(0)
  images       String      @default("[]") // JSON array of image URLs
  featured     Boolean     @default(false)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderItems   OrderItem[]
  reviews      Review[]
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            String      @default("PENDING") // PENDING | CONFIRMED | SHIPPED | DELIVERED | CANCELLED
  paymentMethod     String      @default("COD") // COD | ONLINE | POINTS (paid in full with RAYVE points)
  paymentStatus     String      @default("PENDING") // PENDING | PAID | REFUNDED
  subtotal          Int
  shippingFee       Int         @default(0)
  discount          Int         @default(0)
  couponCode        String?
  total             Int
  razorpayOrderId   String?
  razorpayPaymentId String?
  pointsUsed        Int         @default(0) // RAYVE points spent on this order (1 point = ₹1)
  pointsEarned      Int         @default(0) // RAYVE points this order earns once delivered
  // Shipment with iThink Logistics, once the admin ships the order
  awb               String?
  courier           String?
  trackingUrl       String?
  shipmentStatus    String? // the courier's latest status, e.g. "In Transit"
  shipmentLocation  String?
  shippedAt         DateTime?
  trackedAt         DateTime? // when the status was last fetched from iThink
  shipName          String
  shipPhone         String
  shipLine1         String
  shipLine2         String?
  shipCity          String
  shipState         String
  shipPostalCode    String
  shipCountry       String      @default("India")
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  items             OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  image     String?
  price     Int
  quantity  Int
}

// Product images uploaded from the admin panel when Supabase Storage isn't configured
model Upload {
  id          String   @id @default(cuid())
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())
}

// Newsletter / "notify me" sign-ups (home page and the coming-soon page)
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("newsletter") // newsletter | coming-soon
  createdAt DateTime @default(now())
}

// Discount codes, managed in the admin panel
model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique // stored upper-case
  type        String    @default("PERCENT") // PERCENT | FLAT
  value       Int // percent (1–90) or rupees
  minSubtotal Int       @default(0)
  maxUses     Int? // null = unlimited
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

// Customer reviews; shown on the product page once approved by an admin
model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int // 1–5
  title     String?
  body      String
  photo     String? // uploaded image URL
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([productId, userId]) // one review per customer per frame
}

// RAYVE points ledger: every earn and spend is a row; a customer's balance is the sum of their AVAILABLE rows.
// Points from an order are PENDING until it is delivered, then AVAILABLE. 1 point = ₹1.
model PointsEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  points    Int // positive = added, negative = spent
  kind      String // EARNED | SPENT | REFUNDED | ADJUSTED
  status    String   @default("AVAILABLE") // PENDING | AVAILABLE
  note      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([orderId])
}

// A Razorpay Magic Checkout in progress: the bag the customer opened checkout with. Razorpay calls back with this
// id (the order "receipt") for shipping and coupons, and the real Order is created from it once they pay or choose COD.
model CheckoutSession {
  id              String   @id @default(cuid())
  userId          String
  items           String // JSON: [{ productId, quantity }]
  subtotal        Int // ₹, before any discount code
  razorpayOrderId String?  @unique
  orderId         String?  @unique // our Order, once placed
  createdAt       DateTime @default(now())
}
