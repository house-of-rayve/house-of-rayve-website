# --- Supabase database (Supabase dashboard → Connect) ---
# Transaction pooler (port 6543) — used by the app
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"
# Session pooler (port 5432) — used by `prisma db push`
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"

# --- Supabase Storage for product image uploads (Project Settings → API) ---
# Optional: if left empty, uploads are saved to the local /uploads folder.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"

# Long random string used to sign session tokens (openssl rand -hex 32)
AUTH_SECRET="change-me"

# --- Google sign-in (Google Cloud Console → Google Auth Platform → Clients) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: public site URL used for the Google redirect (defaults to the current domain)
APP_URL=""
